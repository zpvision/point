DATABASE_URL=postgresql://postgres:change-me@localhost:5432/point_dev?sslmode=disable
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:8080
UPLOAD_DIR=var/uploads
STATIC_DIR=web/dist
# Set these only for the first admin bootstrap, then remove.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Browser key: restrict domains in Yandex developer console.
YANDEX_MAPS_API_KEY=
# Server-side keys, never exposed to browser.
YANDEX_GEOCODER_API_KEY=
YANDEX_SUGGEST_API_KEY=
# DaData organization lookup and fallback address suggestions/geocoding when Yandex is unavailable.
DADATA_API_KEY=
# Only development accepts development verification; no production bypass.
VERIFICATION_PROVIDER=disabled
